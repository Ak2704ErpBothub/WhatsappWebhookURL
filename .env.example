# Copy this file to .env and fill in real values. Never commit .env.

# Port the server listens on (Render sets this itself)
PORT=3000

# REQUIRED. Any string you invent. Paste the SAME value into
# Meta Developer Console > WhatsApp > Configuration > Webhook > "Verify token".
VERIFY_TOKEN=change-me-to-a-random-string

# REQUIRED. Shared secret the EBH Orchestrator desktop app sends as
# "Authorization: Bearer <API_KEY>" when pulling /events.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=change-me-to-a-long-random-hex

# RECOMMENDED. Meta Developer Console > App settings > Basic > "App secret".
# Enables X-Hub-Signature-256 checking so only Meta can post to you.
# Leave empty for local testing only (server logs a warning).
APP_SECRET=

# Where the event queue file (events.jsonl) is stored.
# Local: ./data   |   Render: /opt/render/project/src/data (the persistent disk mount)
DATA_DIR=./data

# Max pending events kept before the oldest are dropped
MAX_EVENTS=20000

# winston log level: error | warn | info | debug
LOG_LEVEL=info
